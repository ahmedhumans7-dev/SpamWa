# استبدل بمعلومات حسابك على Twilio
account_sid = 'معرف الحساب'
auth_token = 'رمز المصادقة'
client = Client(account_sid, auth_token)

# استبدل برقم هاتفك و رقم هاتف المتلقي
from_number = 'رقم هاتفك على Twilio'
to_number = 'رقم هاتف المتلقي'

# إرسال رسالة
